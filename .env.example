# Valores locales sintéticos; nunca incluir credenciales productivas en este archivo.
NODE_ENV=development
DATABASE_URL=postgres://portal_dev@127.0.0.1:5432/portal_soporte
# DATABASE_SSL_CA contiene el certificado CA PEM cuando PostgreSQL usa una CA privada.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
PUBLIC_APP_ORIGIN=http://127.0.0.1:3000
API_INTERNAL_ORIGIN=http://127.0.0.1:4100
API_LISTEN_HOST=127.0.0.1
API_LISTEN_PORT=4100
# Rangos exactos del proxy de borde; vacío significa confiar solo en el peer TCP.
TRUSTED_EDGE_PROXY_CIDRS=
# Direcciones internas de Next.js; vacío mantiene la confianza proxy deshabilitada.
TRUSTED_PROXY_CIDRS=

# En un entorno real, configurar en un gestor de secretos con valores generados.
# AUTH_THROTTLE_HMAC_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD=
